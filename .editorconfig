root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8

[*.{bat,cmd,ps1,sln,slnx,csproj,json}]
end_of_line = crlf

[*.{csproj,props,targets,slnx,vcxproj,pubxml,xml,axaml}]
indent_style = tab

[*.cs]
dotnet_diagnostic.IDE0046.severity = none

dotnet_style_allow_multiple_blank_lines_experimental = false

dotnet_diagnostic.IDE0028.severity = error
dotnet_diagnostic.IDE0090.severity = error
dotnet_diagnostic.IDE0305.severity = error
dotnet_diagnostic.IDE0290.severity = error
dotnet_diagnostic.IDE2000.severity = error

dotnet_diagnostic.S112.severity = error
dotnet_diagnostic.S8969.severity = error

dotnet_diagnostic.xUnit1051.severity = error
dotnet_diagnostic.xUnit2032.severity = error

dotnet_diagnostic.SYSLIB1054.severity = error
